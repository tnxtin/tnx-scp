{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "paths": {
      "@/*": ["../src/*"]
    }
  },
  "include": [
    "src",
    "../src/components/tournament",
    "../src/components/ui",
    "../src/hooks",
    "../src/lib/pairing",
    "../src/lib/utils.ts",
    "../src/lib/demo-players.ts"
  ]
}
